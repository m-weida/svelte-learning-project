{
	"name": "svelte-test",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 4173",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173",
		"preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm build && start-server-and-test preview:e2e http://127.0.0.1:4173 \"cypress run\"",
		"test:all": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.5",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"cypress": "^15.19.0",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"jsdom": "^30.0.1",
		"start-server-and-test": "^3.0.11",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
